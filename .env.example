ANTHROPIC_AUTH_TOKEN=your-api-key
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-flash[1m]
ANTHROPIC_REASONING_MODEL=deepseek-v4-flash[1m]

# Bilibili cookie file (Netscape format, export from browser)
# Required when Bilibili returns 412 errors
# Place bilibili_cookies.txt in project root, or use absolute path
# BILIBILI_COOKIES=bilibili_cookies.txt

# Whisper model size (tiny/small/medium/large-v3), empty = default fallback chain
# WHISPER_MODEL=medium

# Obsidian vault integration
# Set OUTPUT_DIR to your Obsidian vault path for direct .md output
# OUTPUT_DIR=D:\tool\ob\know\0604\视频笔记
# OBSIDIAN_VAULT=D:\tool\ob\know\0604
